# Copy to .env and fill in. Both secrets should be long random strings:
#   openssl rand -hex 32

# Shared secret the plugin sends as `Authorization: Bearer <token>`.
# If unset, the ingest endpoint accepts anything - never do that in production.
INGEST_TOKEN=

# HTTP basic auth for the dashboard and read APIs. If unset, the dashboard is open.
DASHBOARD_USER=usage
DASHBOARD_PASS=

# Bind address. Keep 127.0.0.1 and put nginx/Apache in front for TLS.
HOST=127.0.0.1
PORT=4317

DB_FILE=/var/lib/claude-usage-tracker/usage.sqlite

# Mount path when sharing a hostname with another app, e.g. /usage. Leave empty
# when this app owns the whole host. nginx must proxy_pass WITHOUT a trailing
# slash so the prefix reaches the app.
BASE_PATH=

# Hours a dashboard login stays valid.
SESSION_HOURS=12

# Timezone used to group sessions into days on the dashboard.
REPORT_TZ=UTC

# Per-IP rate limits. Raise INGEST if a whole office shares one NAT address:
# each developer posts at most once per turn, throttled by flushIntervalSec.
RATE_LIMIT_INGEST_PER_MIN=600
RATE_LIMIT_READ_PER_MIN=240

# Proxy hops to trust for the client IP. 1 = one reverse proxy (nginx) in front.
# Do NOT set this to `true`: that trusts any X-Forwarded-For, letting a caller
# spoof their IP and walk past the rate limiter.
TRUST_PROXY=1

# --- Full transcripts in Cloudflare R2 --------------------------------------
# All four must be set to enable uploads. Use an R2 API token scoped to
# "Object Read & Write" on this one bucket only.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Days to keep a transcript before it is deleted from R2. 0 keeps forever.
TRANSCRIPT_RETENTION_DAYS=90

# Hard monthly cap, USD, on everything this server spends at Cloudflare
# (R2 storage and requests, Jev). 0 disables the cap.
SPEND_CAP_USD=10

# --- Jev model routing (Cloudflare Workers AI, model typesafe/jev) ------------
# Both must be set to enable routing. Use a Cloudflare API token with only the
# "Workers AI: Read" permission (it covers running models).
CF_ACCOUNT_ID=
CF_AI_TOKEN=
# Jev's answer is applied only at or above this confidence (0-1).
JEV_MIN_CONFIDENCE=0.7
# 1 lets Jev move a session UP to the more expensive model; off by default.
JEV_ALLOW_UPGRADE=0
# How long the proxy's first request of a session may wait for a decision.
JEV_TIMEOUT_MS=1500
# The pair Jev chooses between. Keep them the same generation: older models
# reject the request format current Claude Code sends.
JEV_MODEL_OPUS=claude-opus-5-5
JEV_MODEL_SONNET=claude-sonnet-5-5
