# Copy to .env and fill in. Both secrets should be long random strings:
#   openssl rand -hex 32

# Shared secret the plugin sends as `Authorization: Bearer <token>`.
# If unset, the ingest endpoint accepts anything - never do that in production.
INGEST_TOKEN=

# HTTP basic auth for the dashboard and read APIs. If unset, the dashboard is open.
DASHBOARD_USER=usage
DASHBOARD_PASS=

# Bind address. Keep 127.0.0.1 and put nginx/Apache in front for TLS.
HOST=127.0.0.1
PORT=4317

DB_FILE=/var/lib/claude-usage-tracker/usage.sqlite

# Mount path when sharing a hostname with another app, e.g. /usage. Leave empty
# when this app owns the whole host. nginx must proxy_pass WITHOUT a trailing
# slash so the prefix reaches the app.
BASE_PATH=

# Hours a dashboard login stays valid.
SESSION_HOURS=12

# Timezone used to group sessions into days on the dashboard.
REPORT_TZ=UTC

# Per-IP rate limits. Raise INGEST if a whole office shares one NAT address:
# each developer posts at most once per turn, throttled by flushIntervalSec.
RATE_LIMIT_INGEST_PER_MIN=600
RATE_LIMIT_READ_PER_MIN=240

# Proxy hops to trust for the client IP. 1 = one reverse proxy (nginx) in front.
# Do NOT set this to `true`: that trusts any X-Forwarded-For, letting a caller
# spoof their IP and walk past the rate limiter.
TRUST_PROXY=1
