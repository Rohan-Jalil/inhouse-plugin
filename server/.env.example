# Copy to .env and fill in. Both secrets should be long random strings:
#   openssl rand -hex 32

# Shared secret the plugin sends as `Authorization: Bearer <token>`.
# If unset, the ingest endpoint accepts anything - never do that in production.
INGEST_TOKEN=

# HTTP basic auth for the dashboard and read APIs. If unset, the dashboard is open.
DASHBOARD_USER=usage
DASHBOARD_PASS=

# Bind address. Keep 127.0.0.1 and put nginx/Apache in front for TLS.
HOST=127.0.0.1
PORT=4317

DB_FILE=/var/lib/claude-usage-tracker/usage.sqlite

# Timezone used to group sessions into days on the dashboard.
REPORT_TZ=UTC
